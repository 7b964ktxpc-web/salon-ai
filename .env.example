# Universal Salon AI Platform

# Yandex Cloud & YandexGPT — the only AI provider
YANDEX_CLOUD_FOLDER_ID=
YANDEX_CLOUD_API_KEY=
YANDEX_GPT_MODEL=yandexgpt/latest

# Dedicated signing secret for Beauty AI admin/tenant browser sessions
# Generate a long random value; never commit the real secret.
BEAUTY_AI_SESSION_SECRET=

# Telegram — each salon will have its own bot token in the salon configuration
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
ADMIN_TELEGRAM_IDS=

# Supabase / PostgreSQL — production multi-tenant storage
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App environment
APP_URL=
PORT=3000
NODE_ENV=development
